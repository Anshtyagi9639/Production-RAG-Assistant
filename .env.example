# Copy to .env and fill in the values. .env is git-ignored; never commit it.

# --- App ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the frontend URL)
ALLOWED_ORIGINS=http://localhost:3000

# --- MongoDB Atlas (the database; see backend/seed_data/README.md) ---
# Atlas -> Connect -> Drivers -> Python. Percent-encode special characters in the password.
# Integration tests use a separate "<MONGODB_DATABASE>_test" database on the same cluster.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=copilot
# Connections per process. The driver default (100) suits one long-running server; on Vercel,
# where many short-lived instances each open a pool, use a small value such as 10.
MONGODB_MAX_POOL_SIZE=100
# Development-only login passwords for the seeded admin@copilot.example.com / member@copilot.example.com
# accounts (min 8 characters). Read only by backend/scripts/seed_mongodb.py; stored as argon2 hashes.
SEED_ADMIN_PASSWORD=<strong-admin-password>
SEED_MEMBER_PASSWORD=<strong-member-password>

# --- Redis (Upstash or any cloud Redis) ---
# A URL, not the redis-cli command. Use rediss:// (TLS) for Upstash: Console -> Connect -> "TLS".
# docker-compose overrides this with its redis service if you run the optional containers.
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# --- Qdrant (Qdrant Cloud) ---
# Cluster endpoint (https://...:6333 or without port) and a database API key.
# docker-compose overrides QDRANT_URL with its qdrant service if you run the optional containers.
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>

# --- Auth ---
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_EXPIRE_MINUTES=60

# --- Uploads and file storage ---
MAX_UPLOAD_MB=20
# local | s3. Local files must be shared by the API and the worker (docker-compose uses a volume).
# Vercel deployments require s3: with it, browsers upload straight to the bucket (presigned POST),
# so files above Vercel's 4.5 MB request limit (e.g. MAX_UPLOAD_MB=50) never pass through the API.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/uploads
# Only for STORAGE_BACKEND=s3. Amazon S3: leave S3_ENDPOINT_URL empty and set the bucket's region
# (e.g. ap-south-1). The bucket needs a CORS rule allowing POST from the site's origin.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# How long a presigned upload URL stays valid, in seconds (60-3600).
DIRECT_UPLOAD_EXPIRE_SECONDS=900

# --- Background worker ---
# Uploads are processed by an arq worker. Unset: with ENVIRONMENT=development (and not on Vercel)
# the API runs one inside its own process, so no second terminal is needed. Production runs the
# worker separately (render.yaml), so leave this unset or false there.
# EMBEDDED_WORKER=

# --- Embeddings and retrieval (server-side only; never exposed to the frontend) ---
# Without a key, uploads end FAILED with "Embeddings are not configured" and search returns 503.
OPENAI_API_KEY=<openai-api-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_TOP_K=6
# Minimum cosine similarity for a chunk to count as relevant (to be calibrated).
RETRIEVAL_SCORE_THRESHOLD=0.3
QUERY_EMBEDDING_CACHE_TTL_SECONDS=600

# --- Chat and agent (server-side only; all optional, defaults shown) ---
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
# Retrieved passages sent to the model are cut off at this many tokens.
CONTEXT_TOKEN_BUDGET=6000
# Earlier messages used to rewrite a follow-up into a standalone question.
CHAT_HISTORY_MESSAGES=6
# Extra retrieval rounds the agent may take after its first (0-2).
AGENT_MAX_EXTRA_ROUNDS=2
# Per-user limit on /api/chat, /api/search and /api/agent/run (fixed window, kept in Redis).
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- LangSmith tracing (optional; the app behaves the same with it off) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=copilot

# --- Frontend ---
# The only variable the frontend reads. Public: it is baked into the browser bundle at build time.
# For `npm run dev` outside Docker, put it in frontend/.env.local instead.
# On Vercel (vercel.json routes /api/* to the backend service on the same domain), leave it
# unset: the browser then calls /api on the site's own origin and no CORS is involved. Don't
# import a local .env into Vercel with this line in it. (A localhost value is ignored on a
# deployed page anyway, but leaving it out keeps the bundle clean.)
NEXT_PUBLIC_API_URL=http://localhost:8000
