# Copy to .env and fill in the values. .env is git-ignored; never commit it.

# --- App ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the frontend URL)
ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Used by the postgres container and by docker-compose to build the backend's DATABASE_URL
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
# Used when running the backend outside Docker (docker-compose overrides it).
# Integration tests use a separate "<database>_test" database on the same server and create it
# if missing, so this role needs CREATEDB (the postgres container's user has it).
DATABASE_URL=postgresql+asyncpg://copilot:change-me@localhost:5432/copilot

# --- Redis ---
# docker-compose overrides this with the redis service address
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
# docker-compose overrides this with the qdrant service address
QDRANT_URL=http://localhost:6333
# Only required for Qdrant Cloud; leave empty locally
QDRANT_API_KEY=

# --- Frontend ---
# The only variable the frontend reads. Public: it is baked into the browser bundle at build time.
# For `npm run dev` outside Docker, put it in frontend/.env.local instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
