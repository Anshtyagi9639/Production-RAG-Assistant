# Copy to .env and fill in the values. .env is git-ignored; never commit it.

# --- App ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the frontend URL)
ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Used by the postgres container and by docker-compose to build the backend's DATABASE_URL
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
# Used when running the backend outside Docker (docker-compose overrides it).
# Integration tests use a separate "<database>_test" database on the same server and create it
# if missing, so this role needs CREATEDB (the postgres container's user has it).
DATABASE_URL=postgresql+asyncpg://copilot:change-me@localhost:5432/copilot

# --- Redis ---
# docker-compose overrides this with the redis service address
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
# docker-compose overrides this with the qdrant service address
QDRANT_URL=http://localhost:6333
# Only required for Qdrant Cloud; leave empty locally
QDRANT_API_KEY=

# --- Auth ---
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# --- Uploads and file storage ---
MAX_UPLOAD_MB=20
# local | s3. Local files must be shared by the API and the worker (docker-compose uses a volume).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/uploads
# Only for STORAGE_BACKEND=s3 (e.g. Cloudflare R2)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Embeddings and retrieval (server-side only; never exposed to the frontend) ---
# Without a key, uploads end FAILED with "Embeddings are not configured" and search returns 503.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_TOP_K=6
# Minimum cosine similarity for a chunk to count as relevant (to be calibrated).
RETRIEVAL_SCORE_THRESHOLD=0.3
QUERY_EMBEDDING_CACHE_TTL_SECONDS=600

# --- Frontend ---
# The only variable the frontend reads. Public: it is baked into the browser bundle at build time.
# For `npm run dev` outside Docker, put it in frontend/.env.local instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
